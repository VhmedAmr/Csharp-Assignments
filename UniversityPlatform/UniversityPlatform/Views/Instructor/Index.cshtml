@model IEnumerable<UniversityPlatform.Models.Instructor>

@{
    ViewData["Title"] = "Instructors List";
}

<div class="container mt-4">
    <h2>All Instructors</h2>
    
    <form asp-controller="Instructor" asp-action="Index" method="get" class="mb-3 mt-3">
        <div class="input-group" style="max-width: 500px;">
            <input type="text" name="searchString" class="form-control" placeholder="Search by Instructor Name...">
            <button type="submit" class="btn btn-outline-primary">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear List</a>
        </div>
    </form>
    
    <table class="table table-bordered table-striped mt-3">
        <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Salary</th>
            <th>Department ID</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>$@item.Salary</td>
                <td>@item.Dept_id</td>
                <td>
                    <a asp-controller="Instructor" asp-action="Detail" asp-route-id="@item.Id" class="btn btn-primary btn-sm">View Details</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>