@model UniversityPlatform.Models.Instructor

@{
    ViewData["Title"] = "Instructor Details";
}

<div class="container mt-4">
    <h2>Instructor Profile</h2>
    
    <div class="card mt-3" style="width: 25rem;">
        <div class="card-body">
            <h4 class="card-title">@Model.Name</h4>
            <hr />
            <p class="card-text"><strong>Instructor ID:</strong> @Model.Id</p>
            <p class="card-text"><strong>Image Name:</strong> @Model.Imag</p>
            <p class="card-text"><strong>Salary:</strong> $@Model.Salary</p>
            <p class="card-text"><strong>Address:</strong> @Model.Address</p>
            <p class="card-text"><strong>Department ID:</strong> @Model.Dept_id</p>
            <p class="card-text"><strong>Course ID:</strong> @Model.Crs_id</p>
            
            <a asp-controller="Instructor" asp-action="Index" class="btn btn-secondary mt-2">Back to List</a>
        </div>
    </div>
</div>